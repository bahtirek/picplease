# Copy to .env.local for development. Values are public (they end up in the page).
# API base URL, no trailing slash. Production: https://api.picplease.app
VITE_API_BASE=http://localhost:3000
# WebSocket URL. Production: wss://api.picplease.app/ws
VITE_WS_URL=ws://localhost:3000/ws
# Store links for "Get the app". Leave empty until the apps are listed.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
