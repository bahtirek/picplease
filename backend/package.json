{
  "name": "picplease-backend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rm -rf dist/src/database/migrations && cp -R src/database/migrations dist/src/database/migrations",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "migrate": "npm run build && node --env-file-if-exists=.env dist/scripts/migrate.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --env-file=.env --experimental-vm-modules ./node_modules/.bin/jest",
    "openapi": "npm run build && node dist/scripts/export-openapi.js",
    "r2:check": "npm run build && node --env-file-if-exists=.env dist/scripts/r2-check.js",
    "delivery:check": "npm run build && node --env-file-if-exists=.env dist/scripts/delivery-check.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@aws-sdk/s3-request-presigner": "3.1169.0",
    "@fastify/rate-limit": "11.2.2",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-fastify": "12.5.0",
    "@nestjs/platform-ws": "12.5.0",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/websockets": "12.5.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.13",
    "@nestjs/testing": "12.5.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
